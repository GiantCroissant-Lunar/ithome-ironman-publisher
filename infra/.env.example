# Stable identity. The profile can exist before the first 2026 series article.
ITHOME_PROFILE_URL=https://ithelp.ithome.com.tw/users/20107519
ITHOME_USER_IDENTIFIER=ApprenticeGC
IRONMAN_YEAR=2026
IRONMAN_SERIES_TITLE=From (Unity) Game Dev to Orchestration of (Unity) Game Dev
IRONMAN_CATEGORY=Vibe Coding

# Optional operator overrides only. Normally leave these absent and let the browser
# discover them, then cache verified values in infra/state/publisher-state.json.
# ITHOME_SERIES_URL=
# ITHOME_DRAFTS_URL=
# ITHOME_NEW_ARTICLE_URL=

ARTICLES_DIR=../../articles
REPOSITORY_ROOT=../..
IRONMAN_START_DATE=2026-09-01
IRONMAN_MAX_DAY=30
TIME_ZONE=Asia/Taipei
SCHEDULE_PRIMARY=10:17
SCHEDULE_FALLBACK=20:47

# Both this safety lock and the CLI --publish flag must allow a real publication.
PUBLISH_DRY_RUN=true
PUBLISHED_UPDATE_POLICY=report
BROWSER_CHANNEL=msedge
HEADLESS=false

AUTH_STATE_PATH=../../infra/.auth/storage-state.json
DIAGNOSTICS_DIR=../../infra/diagnostics
STATE_PATH=../../infra/state/publisher-state.json
LOCK_PATH=../../infra/state/publisher.lock
LOCK_STALE_MS=7200000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
VERIFICATION_ATTEMPTS=6
VERIFICATION_DELAY_MS=5000
TRACE_MODE=retain-on-failure
LOG_LEVEL=info

# Leonardo MCP is configured in .codex/config.toml and reads LEONARDO_API_KEY
# from the Codex process environment before the app starts. Do not put the key
# in this file or infra/.env; Leonardo API credits are separate from web plans.
