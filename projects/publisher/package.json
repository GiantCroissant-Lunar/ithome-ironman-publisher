{
  "name": "ithome-ironman-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reliable, idempotent iT 邦鐵人賽 publisher built with TypeScript and Playwright.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "auth": "tsx src/cli/auth-bootstrap.ts",
    "leonardo:auth": "tsx src/cli/leonardo-auth.ts",
    "leonardo:probe": "tsx src/cli/leonardo-probe.ts",
    "leonardo:generate": "tsx src/cli/leonardo-generate.ts",
    "leonardo:promote": "tsx src/cli/leonardo-promote.ts",
    "leonardo:runs:check": "tsx src/cli/leonardo-runs-check.ts",
    "mcp:leonardo": "playwright-mcp --browser msedge --isolated --storage-state ../../infra/.auth/leonardo-storage-state.json --output-dir ../../infra/generated/mcp --save-session --timeout-action 15000 --timeout-navigation 60000",
    "content:check": "tsx src/cli/content-check.ts",
    "images:check": "tsx src/cli/generated-images-check.ts",
    "skills:check": "tsx src/cli/skills-check.ts",
    "draft:sync": "tsx src/cli/draft-sync.ts",
    "publish": "tsx src/cli/publish.ts",
    "publication:sync": "tsx src/cli/publication-sync.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "gray-matter": "^4.0.3",
    "pino": "^9.9.4",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "0.0.80",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.11"
  }
}
